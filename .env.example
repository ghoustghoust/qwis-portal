# QWis Portal 环境变量配置模板
# 复制为 .env 后填入实际值

# 服务端口
PORT=3000

# ===== P0: 鉴权配置（必填） =====
# JWT 密钥（生产环境必须修改为强随机字符串）
AUTH_SECRET=your-strong-random-secret-key-here

# 管理员账号（用于登录接口）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-in-production

# ===== 代理配置（要采海外源才需要；本机 Clash 端口） =====
# ⚠️ 端口以本机代理客户端实际监听值为准，不要照抄别处的数（这里曾长期写着已失效的 7890）。
# ⚠️ NO_PROXY 必须把国内直连域与**报警渠道域**列进来，否则飞书/钉钉/企微的出站请求会被自己的代理吃掉：
HTTPS_PROXY=http://127.0.0.1:12000
HTTP_PROXY=http://127.0.0.1:12000
NO_PROXY=localhost,127.0.0.1,api.deepseek.com,mmbiz.qpic.cn,qpic.cn,wx.qlogo.cn,newsnow.busiyi.world,gateway.feishu.cn,oapi.dingtalk.com,qyapi.weixin.qq.com,api.turso.tech

# ===== 采集口令（runner / 云端写路径必填） =====
# 这是采集链与云端之间那把钥匙：GitHub Secrets、Vercel 环境变量、本机 .env **三处必须同值**。
# 改值时漏任何一处，表现是整条采集 403 停摆且页面看不出来——本项目最大的血泪坑。
COLLECT_KEY=change-me-and-sync-to-vercel-and-gh-secrets

# ===== 云端队列（可选） =====
# CLOUD_BASE_URL=https://your-cloud-api.example.com

# ===== Turso 云端数据库（走云端读层或 runner 时必填，不是可选） =====
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ===== AI 能力（Agnes AI 平台，可选） =====
# AGNES_API_KEY=your-agnes-api-key
# AGNES_API_BASE=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.5-flash

# ===== 应急回退 =====
# AUTH_DISABLED=true  # 仅本机调试时启用
