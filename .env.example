# QWis Portal 环境变量配置模板
# 复制为 .env 后填入实际值

# 服务端口
PORT=3000

# ===== P0: 鉴权配置（必填） =====
# JWT 密钥（生产环境必须修改为强随机字符串）
AUTH_SECRET=your-strong-random-secret-key-here

# 管理员账号（用于登录接口）
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-in-production

# ===== 代理配置（可选） =====
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,api.deepseek.com,mmbiz.qpic.cn,qpic.cn,wx.qlogo.cn,newsnow.busiyi.world

# ===== 云端队列（可选） =====
# CLOUD_BASE_URL=https://your-cloud-api.example.com

# ===== Turso 云端数据库（可选） =====
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token

# ===== AI 能力（Agnes AI 平台，可选） =====
# AGNES_API_KEY=your-agnes-api-key
# AGNES_API_BASE=https://apihub.agnes-ai.com/v1
# AGNES_MODEL=agnes-2.5-flash

# ===== 应急回退 =====
# AUTH_DISABLED=true  # 仅本机调试时启用
