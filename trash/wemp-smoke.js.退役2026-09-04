#!/usr/bin/env node
// we-mp-rss 集成冒烟测试
// 用法: node tools/wemp-smoke.js
const WEMP_BASE = process.env.WEMP_BASE_URL || 'http://127.0.0.1:8001';
const USERNAME = process.env.WEMP_USERNAME || 'admin';
const PASSWORD = process.env.WEMP_PASSWORD || 'admin@123';

async function main() {
  let r;
  try {
    r = await fetch(`${WEMP_BASE}/`);
    console.log(`[1] we-mp-rss 服务 ${WEMP_BASE} -> HTTP ${r.status}`);
  } catch (e) {
    console.error(`[1] we-mp-rss 不可达: ${e.message}`);
    process.exit(1);
  }

  const body = new URLSearchParams({ username: USERNAME, password: PASSWORD });
  const loginRes = await fetch(`${WEMP_BASE}/api/v1/wx/auth/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: body.toString(),
  });
  const login = await loginRes.json();
  if (!login.data || !login.data.access_token) throw new Error('登录失败: ' + JSON.stringify(login).slice(0, 200));
  const token = login.data.access_token;
  console.log(`[2] 登录成功 token=${token.slice(0, 12)}...`);

  const headers = { Authorization: `Bearer ${token}` };
  const mps = await (await fetch(`${WEMP_BASE}/api/v1/wx/mps?page=1&size=50`, { headers })).json();
  const feeds = (mps.data && mps.data.list) || [];
  console.log(`[3] 已订阅公众号: ${feeds.length} 个`);
  for (const f of feeds.slice(0, 10)) {
    console.log(`    - ${f.mp_name || f.id} [${f.id}] status=${f.status}`);
    try {
      const fr = await fetch(`${WEMP_BASE}/feed/${f.id}.atom?limit=2`, { headers });
      const xml = await fr.text();
      const titles = [...xml.matchAll(/<title>([^<]+)<\/title>/g)].map(m => m[1]).slice(0, 3);
      console.log(`      feed/${f.id}.atom -> HTTP ${fr.status}, 标题样例: ${titles.join(' | ').slice(0, 80)}`);
    } catch (e) {
      console.log(`      feed 获取失败: ${e.message}`);
    }
  }
  console.log('[OK] 冒烟测试完成');
}

main().catch((e) => { console.error('[FAIL]', e.message); process.exit(1); });