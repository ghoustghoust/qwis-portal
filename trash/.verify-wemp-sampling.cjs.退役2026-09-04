// tools/verify-wemp-sampling.cjs - 公众号采集采样验证

const http = require('http');
const { db } = require('../server/db');

const sources = [
  { id: 133, name: '极客公园', feedId: 'MP_WXS_1304308441' },
  { id: 132, name: '晚点 LatePost', feedId: 'MP_WXS_3572959446' },
  { id: 131, name: '机器之心', feedId: 'MP_WXS_3073282833' },
  { id: 130, name: '新智元', feedId: 'MP_WXS_3271041950' },
  { id: 129, name: '夕小瑶科技说', feedId: 'MP_WXS_3207765945' },
  { id: 128, name: '特工宇宙', feedId: 'MP_WXS_3621654047' }
];

async function checkFeed(source) {
  return new Promise((resolve, reject) => {
    const req = http.get(`http://127.0.0.1:8001/feed/${source.feedId}.atom?limit=20`, res => {
      let data = '';
      res.on('data', chunk => data += chunk);
      res.on('end', async () => {
        try {
          const titleCount = (data.match(/<title>/g) || []).length;
          const updatedMatch = data.match(/<updated>([^<]+)<\/updated>/);
          const encodedMatch = data.match(/<content:encoded[^>]*>(.*?)<\/content:encoded>/gs);
          const emptyEncoded = (data.match(/<content:encoded \/?>/g) || []).length;
          
          // 解析最新的 pubDate
          const pubDateMatches = data.matchAll(/<published>([^<]+)<\/published>/g);
          let latestPubDate = null;
          for (const match of pubDateMatches) {
            if (!latestPubDate) latestPubDate = match[1];
          }
          
          const feedEntries = [];
          if (encodedMatch) {
            for (let i = 0; i < Math.min(5, encodedMatch.length); i++) {
              const content = encodedMatch[i][1]?.trim();
              feedEntries.push({
                title: data.split('<title>')[i + 1]?.split('</title>')[0] || '',
                hasContent: !!content && content.length > 10,
                contentLen: content?.length || 0
              });
            }
          }

          resolve({
            name: source.name,
            entries: titleCount,
            updated: updatedMatch ? updatedMatch[1] : null,
            latestPubDate,
            emptyEncodedCount: emptyEncoded,
            feedEntriesSample: feedEntries
          });
        } catch (e) {
          reject(e);
        }
      });
    });
    req.on('error', reject);
    req.setTimeout(5000, () => { req.destroy(); reject(new Error('timeout')); });
  });
}

async function checkMainDb(source) {
  const q = `
    SELECT 
      id, url, title, published_at, created_at, 
      LENGTH(content_html) as clen,
      CASE WHEN LENGTH(content_html) > 500 THEN 'full' ELSE 'summary' END as type
    FROM articles
    WHERE source_id = ?
    ORDER BY published_at DESC
    LIMIT 10
  `;
  const rows = db.prepare(q).all(source.id);
  
  const summary = {
    total: rows.length,
    fullCount: rows.filter(r => r.type === 'full').length,
    summaryCount: rows.filter(r => r.type === 'summary').length,
    avgLength: rows.reduce((sum, r) => sum + r.clen, 0) / (rows.length || 1),
    latestPublished: rows[0]?.published_at || null,
    delays: rows.map(r => ({
      url: r.url.substring(0, 50) + '...',
      delayMin: Math.round((new Date(r.created_at) - new Date(r.published_at)) / 60000),
      type: r.type
    }))
  };
  
  return summary;
}

async function main() {
  console.log('[WEMP SAMPLING AUDIT]'.padEnd(80, '='));
  console.log(`Time: ${new Date().toISOString()}\n`);
  
  const results = [];
  
  for (const source of sources) {
    console.log(`\n>>> ${source.name} (ID: ${source.id})`);
    
    try {
      const feedData = await checkFeed(source);
      const dbData = await checkMainDb(source);
      
      const result = {
        ...feedData,
        ...dbData,
        sourceId: source.id,
        syncStatus: {
          feedEntries: feedData.entries,
          dbArticles: dbData.total,
          diff: feedData.entries - dbData.total,
          fulltextRate: `${Math.round(dbData.fullCount / (dbData.total || 1) * 100)}%`,
          maxDelayMin: Math.max(...dbData.delays.map(d => d.delayMin))
        }
      };
      
      results.push(result);
      
      console.log(`  Feed:   ${feedData.entries} entries, latestPubDate=${feedData.latestPubDate || 'N/A'}`);
      console.log(`  DB:     ${dbData.total} articles (${dbData.fullCount} full, ${dbData.summaryCount} summary)`);
      console.log(`  Avg len: ${Math.round(dbData.avgLength)} chars | Max delay: ${result.syncStatus.maxDelayMin}min`);
      
    } catch (err) {
      console.error(`  ERROR: ${err.message}`);
      results.push({ sourceId: source.id, name: source.name, error: err.message });
    }
  }
  
  // Output JSON to file
  const fs = require('fs');
  const outfile = 'tools/.wemp-sampling-audit.json';
  fs.writeFileSync(outfile, JSON.stringify(results, null, 2));
  console.log(`\n${'\n'.repeat(2)}[${'}SAMPLING AUDIT COMPLETE${'}]`.padEnd(80, '-'));
  console.log(`Full results saved to: ${outfile}`);
}

main().catch(err => {
  console.error('Fatal:', err);
  process.exit(1);
});
