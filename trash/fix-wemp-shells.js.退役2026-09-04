// 一次性修复:wemp 文章里的风控错误页(参数错误等)与极短正文 → 用修好的 fetchFulltext 重抓
const path = require('path');
process.env.APP_DATA_DIR = process.env.APP_DATA_DIR || path.join(__dirname, '..', 'data');
const { db } = require('../server/db');
const { _internals } = require('../server/services/collectors/rss');

async function main() {
  const rows = db.prepare(
    "SELECT a.id, a.url, a.title FROM articles a JOIN sources s ON s.id=a.source_id WHERE s.type='wemp' AND (length(a.content_html)<200 OR a.content_html LIKE '%参数错误%' OR a.content_html LIKE '%环境异常%' OR (a.content_html LIKE '%js_article%' AND length(a.content_html)<2500))"
  ).all();
  console.log('待修复:', rows.length);
  const upd = db.prepare('UPDATE articles SET content_html=?, summary=? WHERE id=?');
  let ok = 0, fail = 0;
  for (const r of rows) {
    try {
      const full = await _internals.fetchFulltext(r.url);
      if (full && full.content && full.content.length > 500 && !_internals.isJunkContent?.(full.content)) {
        const summary = full.content.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 200);
        upd.run(full.content, summary, r.id);
        ok++;
        console.log(` ✔ #${r.id} ${r.title.slice(0, 25)} (${full.content.length} 字符)`);
      } else {
        fail++;
        console.log(` ✘ #${r.id} 仍拿不到正文`);
      }
    } catch (e) {
      fail++;
      console.log(` ✘ #${r.id} ${String(e.message).slice(0, 60)}`);
    }
    await new Promise((r2) => setTimeout(r2, 3000)); // 微信风控:限速 3s/篇
  }
  console.log(`完成: 修复 ${ok}, 失败 ${fail}`);
}

main().catch((e) => { console.error('FATAL:', e); process.exit(1); });
