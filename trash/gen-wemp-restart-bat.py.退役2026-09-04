# -*- coding: utf-8 -*-
# 生成 we-mp-rss 重启脚本(GBK 编码,cmd 兼容)
import os

BAT = r"""@echo off
chcp 936 >nul
cd /d "%~dp0"
echo 正在结束旧的 WeRSS 进程(8001 端口)...
set KILLED=0
for /f "tokens=5" %%a in ('netstat -ano ^| findstr ":8001 " ^| findstr "LISTENING"') do (
    echo 结束 PID %%a
    taskkill /PID %%a /T /F && set KILLED=1
)
if "%KILLED%"=="0" (
    echo.
    echo [提示] 若显示拒绝访问,请关闭本窗口,右键脚本选「以管理员身份运行」
    pause
    exit /b 1
)
echo 正在启动 WeRSS...
set /p SECRET_KEY=<data\.secret_key
set SECRET_KEY=%SECRET_KEY%
.venv\Scripts\python.exe main.py -job True -init True
"""

out = os.path.join(r'D:\tools\we-mp-rss', 'restart-wemp.bat')
open(out, 'wb').write(BAT.replace('\n', '\r\n').encode('gbk'))
print(out, 'written')
