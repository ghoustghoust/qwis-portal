// 九期 M3:公众号号库批量导入 —— 种子名单 → we-mp-rss 搜索/订阅 → 情报系统 sync + 领域分组
// 用法: node tools/seed-mp-library.js
// 限速:每次搜索/添加间隔 3s,防微信读书风控;we-mp-rss 侧首抓由 TaskQueue 串行消化
const path = require('path');
process.env.APP_DATA_DIR = process.env.APP_DATA_DIR || path.join(__dirname, '..', 'data');
const { db } = require('../server/db');

const WEMP = process.env.WEMP_BASE_URL || 'http://127.0.0.1:8001';
const QS = process.env.QWIS_BASE || 'http://127.0.0.1:3000';
const SEED = require('./mp-library-seed.json');
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

async function wempToken() {
  const r = await fetch(`${WEMP}/api/v1/wx/auth/login`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams({ username: 'admin', password: 'admin@123' }).toString(),
  });
  const j = await r.json();
  return j.data.access_token;
}

async function main() {
  const tok = await wempToken();
  const h = { Authorization: `Bearer {tok}`.replace('{tok}', tok) };
  // 已有订阅(避免重复添加)
  const existing = await fetch(`${WEMP}/api/v1/wx/mps?page=1&size=200`, { headers: h }).then((r) => r.json());
  const existingNames = new Set((existing.data.list || []).map((f) => f.mp_name));

  const results = { added: [], skipped: [], notFound: [], failed: [] };
  for (const [domain, names] of Object.entries(SEED)) {
    for (const rawName of names) {
      const name = rawName.trim();
      if (existingNames.has(name)) { results.skipped.push(name); continue; }
      try {
        const s = await fetch(`${WEMP}/api/v1/wx/mps/search/${encodeURIComponent(name)}?limit=5`, { headers: h }).then((r) => r.json());
        const cands = (s.data && s.data.list) || [];
        const pick = cands.find((c) => c.nickname === name) || cands[0];
        if (!pick) { results.notFound.push(`${name}(${domain})`); await sleep(3000); continue; }
        const add = await fetch(`${WEMP}/api/v1/wx/mps`, {
          method: 'POST', headers: { ...h, 'Content-Type': 'application/json' },
          body: JSON.stringify({
            mp_name: pick.nickname, mp_id: pick.fakeid,
            avatar: pick.round_head_img || '', mp_intro: (pick.signature || '').slice(0, 200),
          }),
        }).then((r) => r.json());
        if (add.code === 0) {
          results.added.push(`${pick.nickname}(${domain})`);
          existingNames.add(pick.nickname);
        } else {
          results.failed.push(`${name}: ${add.message}`);
        }
      } catch (e) {
        results.failed.push(`${name}: ${e.message}`);
      }
      await sleep(3000);
    }
  }
  console.log(`搜索添加完成: 新增 ${results.added.length}, 已存在 ${results.skipped.length}, 未命中 ${results.notFound.length}, 失败 ${results.failed.length}`);
  if (results.notFound.length) console.log('未命中:', results.notFound.join('、'));
  if (results.failed.length) console.log('失败:', results.failed.join('、'));

  // 同步到情报系统
  const sync = await fetch(`${QS}/api/wemp/sync`, { method: 'POST' }).then((r) => r.json());
  console.log('情报系统 sync:', JSON.stringify(sync));

  // 按领域回写分组
  const name2domain = new Map();
  for (const [domain, names] of Object.entries(SEED)) for (const n of names) name2domain.set(n.trim(), domain);
  const groupId = (name) => {
    const g = db.prepare("SELECT id FROM groups WHERE kind='article' AND name=?").get(name);
    if (g) return g.id;
    const m = db.prepare("SELECT COALESCE(MAX(sort),0) m FROM groups WHERE kind='article'").get().m;
    return db.prepare("INSERT INTO groups(kind, name, sort) VALUES('article', ?, ?)").run(name, m + 1).lastInsertRowid;
  };
  const wempSources = db.prepare("SELECT id, name FROM sources WHERE type='wemp'").all();
  let grouped = 0;
  for (const s of wempSources) {
    const domain = name2domain.get(s.name);
    if (domain) {
      db.prepare('UPDATE sources SET group_id=? WHERE id=?').run(groupId(domain), s.id);
      grouped++;
    }
  }
  console.log(`领域分组回写: ${grouped} 个源`);
}

main().catch((e) => { console.error('FATAL:', e); process.exit(1); });
