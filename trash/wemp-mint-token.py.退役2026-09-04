#!/usr/bin/env python
"""we-mp-rss admin JWT 铸币脚本（服务端 SECRET_KEY = data/.secret_key）
用法: D:/tools/we-mp-rss/.venv/Scripts/python.exe wemp-mint-token.py
输出: 打印 token 并写入 C:/Users/17619/.openclaw-autoclaw/agents/agent-ag5kap/workspace/.openclaw/tmp/wemp_admin_token.txt
"""
import os, sys, urllib.request, urllib.error
sys.path.insert(0, r"D:\tools\we-mp-rss")
os.chdir(r"D:\tools\we-mp-rss")
from core.auth import SECRET_KEY, ALGORITHM
import jwt

tok = jwt.encode({"sub": "admin"}, SECRET_KEY, algorithm=ALGORITHM)
out = r"C:\Users\17619\.openclaw-autoclaw\agents\agent-ag5kap\workspace\.openclaw\tmp\wemp_admin_token.txt"
open(out, "w").write(tok)

req = urllib.request.Request("http://127.0.0.1:8001/api/v1/wx/auth/verify",
    headers={"Authorization": "Bearer " + tok})
try:
    body = urllib.request.urlopen(req, timeout=15).read().decode()
    print("VERIFY:", body[:120])
    print("TOKEN_SAVED:", out)
except urllib.error.HTTPError as e:
    print("VERIFY FAILED HTTP", e.code)
    print("HINT: 服务进程的 SECRET_KEY 与 data/.secret_key 不一致（可能服务带不同环境变量启动）。重启服务并注入 SECRET_KEY 环境变量。")