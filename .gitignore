node_modules/
/data/
.env
web/dist/
portal/dist/
portal/dist-admin/
*.log

# 敏感凭据
cloud/token.json
tools/.auth-probe.*
tools/.leak-probe.*

# PHP 便携测试运行时
tools/.php-runtime/

# AI 工具内部状态
.qoder/
.autoclaw/
.opencode/

# 归档子项目的 node_modules
archive/_eval/wechat-rss-plus/node_modules/
archive/_eval/wechat-rss-plus/.vscode/

# 门户独立 git 仓库内部
portal/.vercel/

# 数据库文件（运行时生成）
db
db-wal
*.db
*.db-shm
*.db-wal

# 验证截图（统一归档目录）
验证截图/

# Vercel 本地缓存
.vercel/

# 构建产物内部
archive/_eval/wechat-rss-plus/

# 含敏感凭据的交接文档，勿提交（GitHub 会扫描吊销 PAT）
docs/HANDOVER.md

# Python 侧评测工具（41-8）的字节码缓存
__pycache__/
*.pyc

# 回归测试的子进程驱动（B77/B83 模板：测试在仓库根写一个 .<用例>-driver-<pid>.cjs 再 spawn，
# 正常由 after() 删掉；被中断时会留在那里）。这些文件里带本地文件库路径与自签 token，
# 且是一次性产物——不忽略就等于让下一次 git add -A 有机会把中断残留提交上去。
.-*-driver-*.cjs
.*-driver-*.cjs
.*-fix-*.cjs
.tmp-*-*.cjs
# 主代理本轮的一次性取证脚手架目录（探针脚本 + 下载的 runner 日志 + 端点响应），整目录不入库：
# 里面有 /api/* 响应与 GH Actions 日志，一次 `git add -A` 就会把外部产物混进提交（同 B113/放行清单 #14 的形状）
.tmpchk/
