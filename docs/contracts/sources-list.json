{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /api/sources 响应结构",
  "description": "订阅源列表接口——本地 Express 与 Vercel Portal 两侧均须遵循此契约",
  "type": "object",
  "required": ["ok", "items"],
  "properties": {
    "ok": { "type": "boolean", "const": true },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "name", "url", "enabled"],
        "properties": {
          "id": { "type": "integer" },
          "type": { "type": "string" },
          "name": { "type": "string" },
          "url": { "type": "string" },
          "avatar": { "type": ["string", "null"] },
          "enabled": { "type": "integer", "enum": [0, 1] },
          "group_id": { "type": ["integer", "null"] },
          "focus": { "type": "integer", "enum": [0, 1] },
          "extra": { "type": "string" },
          "created_at": { "type": "string" },
          "last_fetched_at": { "type": ["string", "null"] },
          "next_fetch_at": { "type": ["string", "null"] },
          "unread": { "type": "integer", "minimum": 0 },
          "intervalMin": { "type": ["number", "null"] },
          "lastError": { "type": ["string", "null"] },
          "lastErrorAt": { "type": ["string", "null"] },
          "marksFeatured": { "type": "boolean" }
        }
      }
    }
  }
}
