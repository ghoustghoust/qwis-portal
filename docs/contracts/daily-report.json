{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GET /api/daily 响应结构",
  "description": "日报接口——本地 Express 与 Vercel Portal 两侧均须遵循此契约",
  "type": "object",
  "required": ["ok", "report"],
  "properties": {
    "ok": { "type": "boolean", "const": true },
    "report": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": "integer" },
        "generated_at": { "type": "string" },
        "window_hours": { "type": "number" },
        "stats": {
          "type": "object",
          "properties": {
            "candidates": { "type": "integer" },
            "articles": { "type": "integer" },
            "videos": { "type": "integer" },
            "windowHours": { "type": "number" },
            "sortMode": { "type": "string" },
            "droppedBadItems": { "type": "integer" },
            "cocoonEvents": { "type": "integer" }
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["column", "col_id", "items"],
            "properties": {
              "column": { "type": "string" },
              "col_id": { "type": "string" },
              "desc": { "type": "string" },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "title", "source_name", "url"],
                  "properties": {
                    "kind": { "type": "string", "enum": ["article", "video", "event"] },
                    "ref_id": { "type": "integer" },
                    "title": { "type": "string" },
                    "summary": { "type": "string" },
                    "cover": { "type": "string" },
                    "source_name": { "type": "string" },
                    "url": { "type": "string" },
                    "published_at": { "type": "string" },
                    "hits": { "type": "integer" },
                    "score": { "type": ["number", "null"] },
                    "tags": { "type": "string" },
                    "related": { "type": "array" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "stale": { "type": "boolean" }
  }
}
